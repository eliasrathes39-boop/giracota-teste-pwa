{
  "id": "/",
  "name": "GiraCota Teste",
  "short_name": "GiraCota",
  "description": "Receba o PDF do pedido direto pelo menu Compartilhar",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#08302F",
  "theme_color": "#08302F",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/receber",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "pdf", "accept": ["application/pdf", ".pdf"] }
      ]
    }
  }
}
